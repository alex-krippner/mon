{
  "$schema": "https://opencode.ai/config.json",

  "instructions": ["AGENTS.md"],

  "model": "ollama/gemma4:31b-cloud",

  "small_model": "ollama/qwen2.5-coder:7b",
  "permission": {
    "bash": "ask",
    "edit": "allow",
    "read": "allow"
  },

  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.git/**",
      "**/dist/**",
      "**/.next/**",
      "*.log",
      "package-lock.json",
      "yarn.lock"
    ]
  },
  "providers": {
    "ollama": {
      "settings": {
        "baseURL": "http://localhost:11434/v1"      }
    }
  },
  "mcp": {
    "servers": {
      "oreilly": {
        "type": "remote",
        "url": "https://api.oreilly.com/api/search/v1/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:OREILLY_MCP_TOKEN}"
        }
      }
    }
  }
}